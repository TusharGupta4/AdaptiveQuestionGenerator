# ==============================================================================
# CollegePur Assessment Ecosystem - Environment Configuration
# ==============================================================================

# Database Connection (Choose ONE of the options below):
# Option A: Local SQLite (Zero-setup, 100% portable, works out of the box)
DATABASE_URL=sqlite:///./data/exam_engine.db

# Option B: Local PostgreSQL (Production / Master DB)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/collegepur_db

# Option C: Supabase Cloud PostgreSQL
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# AI Evaluation & OCR API Keys (Optional - System includes local heuristic fallbacks)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

